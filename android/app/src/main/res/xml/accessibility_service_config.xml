<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberately narrow. Lyraa only needs to know which app came to the front;
  everything else is read on demand when Dhruv asks for an action, rather than
  streamed continuously. Fewer events means less data and less battery.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="200"
    android:settingsActivity="com.lyraa.assistant.MainActivity" />
